# Salin menjadi .env.local lalu isi dengan nilai dari Supabase Dashboard
# (Project Settings -> API / API Keys). JANGAN commit .env.local.

# URL project Supabase hosted, contoh: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable key (sb_publishable_...) — aman untuk sisi publik, dilindungi RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Alternatif untuk project lama: legacy anon key (dipakai bila PUBLISHABLE_KEY kosong).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opsional: URL situs production untuk metadata, contoh https://tpu-astana-pratiksha.vercel.app
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Hanya untuk tes E2E Admin (opsional, jangan diisi di Vercel):
# akun Admin khusus pengujian yang sudah terdaftar di tabel admin_users.
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# Akun uji login yang BUKAN Admin (untuk npm run test:security:live):
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=
#
# TIDAK ADA service-role key yang dibutuhkan aplikasi. Jangan pernah menaruhnya
# di variabel NEXT_PUBLIC_* atau di Vercel project ini.
