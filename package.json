{
  "name": "tpu-astana-pratiksha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-build.mjs && playwright test",
    "db:setup-sql": "node scripts/build-setup-sql.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:live:write": "node scripts/run-live-write-tests.mjs e2e --confirm-production-writes",
    "test:security:live": "node scripts/live-security-check.mjs",
    "test:security:live:write": "node scripts/run-live-write-tests.mjs security --confirm-production-writes"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "22.x"
  }
}
